      m_Calls: []
  m_text: "uniform float sampleCount; // %3% int 1..64\r\nuniform float power; //
    %0.01%\r\n\r\nvec3 chromatic_slice(float t) {\r\n  vec3 res = vec3(1.0 - t, 1.0
    - abs(t - 1.0), t - 1.0);\r\n  return max(res, 0.0);\r\n}\r\n\r\nvoid mainImage(
    out vec4 fragColor, in vec2 fragCoord ){\r\n  vec2 uv = fragCoord;\r\n  vec3
    sum = vec3(0.0);\r\n  vec3 c = vec3(0.0);\r\n  vec2 offset = (uv - vec2(0.5))
    * vec2(1, -1);\r\n  int sample_count = int(sampleCount);\r\n  for (int i = 0;
    i < 64; ++i) {\r\n    if (i >= sample_count) break;\r\n    float t = 2.0 * float(i)
    / float(sample_count - 1); // range 0.0->2.0\r\n    vec3 slice = vec3(1.0 - t,
    1.0 - abs(t - 1.0), t - 1.0);\r\n    slice = max(slice, 0.0);\r\n    sum += slice;\r\n   
    vec2 slice_offset = (t - 1.0) * power * offset;\r\n    c += slice * tex2D(uv
    + slice_offset).rgb;\r\n  }\r\n  fragColor.rgb = c / sum;\r\n  fragColor.a =
    1;\r\n}\u200B"
